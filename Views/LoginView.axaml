<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AirportSystem.Avalonia.Views.LoginView">
    <StackPanel Margin="20" Width="300">
        <TextBlock Text="Вход в систему" FontSize="20"/>
        <TextBox PlaceholderText="Имя пользователя" Text="{Binding Username}" Margin="0,10"/>
        <TextBox PlaceholderText="Пароль" Text="{Binding Password}" PasswordChar="*" Margin="0,10"/>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"/>
        <Button Content="Войти" Command="{Binding LoginCommand}" Margin="0,10"/>
        <Button Content="Отмена" Command="{Binding CancelCommand}" Margin="0,5"/>
    </StackPanel>
</UserControl>
