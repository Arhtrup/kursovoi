<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AirportSystem.Avalonia.Views.OfficeEmployeeView">
    <StackPanel Margin="10">
        <TextBlock Text="Офисный сотрудник" FontSize="20"/>
        <TextBlock Text="{Binding Message}"/>
        <Button Content="Тест" Command="{Binding TestCommand}" Margin="0,10"/>
    </StackPanel>
</UserControl>
